@using System.Security.Claims
@using OAuthFlowDemo.Services
@inject OidcEventStore EventStore
@{
    ViewData["Title"] = "Home";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var latestEvent = EventStore.GetLatest();
}

<div class="card">
    <h2>OAuth 2.0 / OpenID Connect Flow Demo</h2>
    <p style="color: #666; margin-bottom: 1rem;">
        This application demonstrates every stage of the OAuth 2.0 authorization code flow
        using Azure AD and ASP.NET Core. Sign in to see each step captured in the
        <a href="/diagnostics">diagnostics timeline</a>.
    </p>

    @if (isAuthenticated)
    {
        <p>
            <span class="badge badge-success">Authenticated</span>
            via @User.Identity?.AuthenticationType
        </p>
    }
    else
    {
        <p>
            <span class="badge badge-danger">Not authenticated</span>
            — click <a href="/sign-in">Sign In</a> to start the flow.
        </p>
    }
</div>

@if (isAuthenticated)
{
    <div class="card">
        <h2>Your Claims (from ID Token)</h2>
        <table>
            <tr><th style="text-align: left; width: 220px; padding: 0.25rem 0.5rem; border-bottom: 1px solid #eee;">Claim Type</th><th style="text-align: left; padding: 0.25rem 0.5rem; border-bottom: 1px solid #eee;">Value</th></tr>
            @foreach (var claim in User.Claims)
            {
                <tr>
                    <td style="padding: 0.25rem 0.5rem; border-bottom: 1px solid #eee; font-family: monospace; font-size: 0.85rem;">@claim.Type</td>
                    <td style="padding: 0.25rem 0.5rem; border-bottom: 1px solid #eee; font-family: monospace; font-size: 0.85rem; word-break: break-all;">@claim.Value</td>
                </tr>
            }
        </table>
    </div>

    <div class="card">
        <h2>Test API Endpoints</h2>
        <p style="margin-bottom: 0.75rem;">These endpoints demonstrate authorization policies. Open them in a new tab:</p>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/api/public" target="_blank" class="btn btn-outline">/api/public</a>
            <a href="/api/me" target="_blank" class="btn btn-outline">/api/me</a>
            <a href="/api/operator" target="_blank" class="btn btn-outline">/api/operator</a>
            <a href="/api/admin" target="_blank" class="btn btn-outline">/api/admin</a>
            <a href="/api/scopes" target="_blank" class="btn btn-outline">/api/scopes</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <h2>The OAuth Authorization Code Flow</h2>
        <p style="margin-bottom: 0.75rem; color: #555;">
            Here's what happens when you click Sign In:
        </p>
        <div class="flow-diagram">
            <span class="flow-step">Browser</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">App /sign-in</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">Azure AD /authorize</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">User Login</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">Auth Code</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">Token Exchange</span>
            <span class="flow-arrow">→</span>
            <span class="flow-step">ID/Access Token</span>
        </div>
        <p style="margin-top: 1rem;">
            <a href="/sign-in" class="btn btn-primary">Start the Flow →</a>
        </p>
    </div>

    @if (System.Text.RegularExpressions.Regex.IsMatch(Context.RequestServices.GetRequiredService<Microsoft.Extensions.Configuration.IConfiguration>().GetValue<string>("AuthMode") ?? "", "Testing", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
    {
        <div class="card">
            <h2>Testing Mode — Quick Sign-In</h2>
            <p style="color: #666; margin-bottom: 0.75rem;">
                Skip Azure AD setup by signing in with a test identity:
            </p>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="/testing/sign-in/customer" class="btn btn-outline">Sign In as Customer</a>
                <a href="/testing/sign-in/operator" class="btn btn-outline">Sign In as Operator</a>
                <a href="/testing/sign-in/admin" class="btn btn-outline">Sign In as Administrator</a>
            </div>
        </div>
    }
}

@if (latestEvent is not null)
{
    <div class="card">
        <h2>Latest Captured Event</h2>
        <div class="event-meta">@latestEvent.FlowPhase — @latestEvent.Timestamp.LocalDateTime.ToString("HH:mm:ss.fff")</div>
        <div class="event-type">@latestEvent.EventType</div>
        <div class="event-details">
            <table>
                @foreach (var detail in latestEvent.Details)
                {
                    <tr><td>@detail.Key</td><td>@detail.Value</td></tr>
                }
            </table>
        </div>
        <p style="margin-top: 0.75rem;"><a href="/diagnostics" class="btn btn-outline">View Full Timeline</a></p>
    </div>
}
